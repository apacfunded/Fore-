# Supabase (Project Settings -> API). The service role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's address (used for link previews)
NEXT_PUBLIC_SITE_URL=https://foregolf.lol

# Your coin's mint address. The pool estimate reads this coin's trading volume from DexScreener.
TOKEN_MINT=YourTokenMintAddressHere
NEXT_PUBLIC_TOKEN_SYMBOL=FORE

# Creator fee you earn per trade, in percent. Pump.fun pays 0.30% on the bonding curve.
# After graduation it drops with market cap (down to 0.05%); update this as your coin grows.
CREATOR_FEE_PCT=0.30

# SOL already in the pool when the site goes live (fees you earned before launch). Can be 0.
STARTING_POOL_SOL=0

# Rounds are practice (no payouts) until the pool first reaches this much SOL. 0 = pay out from the start.
MIN_POOL_SOL=0

# Share of the pool paid per win (0.10 = 10%)
PAYOUT_SHARE=0.10
# Most a single win can pay, in SOL
MAX_PAYOUT_SOL=0.5

# Round length by pool size: "pool SOL:seconds" pairs. Bigger pool, faster rounds.
# Default: under 10 SOL every 5 min, 10+ every 3 min, 25+ every 2 min, 50+ every minute, 100+ every 30 sec.
ROUND_TIERS=0:300,10:180,25:120,50:60,100:30
# Practice rounds (before the pool first reaches MIN_POOL_SOL) run this often
PRACTICE_ROUND_SECONDS=60

# Optional. Only used to read a recent Solana blockhash once per round for the winner draw.
# The public endpoint is fine for that.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Admin page password and cron secret. Use long random strings.
ADMIN_KEY=change-me-long-random-string
CRON_SECRET=change-me-another-long-random-string
